# =============================================================================
# Boilerplate Application - Environment Configuration
# Copy this file to .env and fill in your values: cp .env.template .env
# =============================================================================

# -----------------------------------------------------------------------------
# Module Toggles
# Enable/disable optional modules (auth, gdpr, seo are always enabled)
# -----------------------------------------------------------------------------
ENABLE_PAYMENTS=true
ENABLE_TRACKING=true
ENABLE_CHATBOT=false
ENABLE_MARKETING=true
ENABLE_RECOMMENDATIONS=true

# Template choice: "ecommerce" or "saas"
APP_TEMPLATE=ecommerce

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=BoilerplateApp
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret

# -----------------------------------------------------------------------------
# Domain & URLs
# -----------------------------------------------------------------------------
DOMAIN=localhost
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=change-me
POSTGRES_DB=boilerplate_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Connection pool settings
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_POOL_SIZE=10

# TTLs in seconds
SESSION_TTL=604800          # 7 days
CART_TTL=86400              # 24 hours
RATE_LIMIT_WINDOW=60        # 1 minute

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY=900              # 15 minutes (access token)
REFRESH_TOKEN_TTL=604800    # 7 days
MAX_SESSIONS_PER_USER=5

# -----------------------------------------------------------------------------
# OAuth Providers
# -----------------------------------------------------------------------------
# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Microsoft / Azure AD
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generic OIDC
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# -----------------------------------------------------------------------------
# Stripe (Payments)
# -----------------------------------------------------------------------------
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# -----------------------------------------------------------------------------
# Currency
# -----------------------------------------------------------------------------
DEFAULT_CURRENCY=USD

# -----------------------------------------------------------------------------
# Abandoned Cart & Recommendations
# -----------------------------------------------------------------------------
CART_ABANDON_TIMEOUT=60             # minutes of inactivity before cart is abandoned
RECOMMENDATION_PROVIDER=default
RFM_COMPUTE_SCHEDULE=daily

# -----------------------------------------------------------------------------
# Email / Notifications
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=placeholder          # placeholder, mailgun, sendgrid, postmark
FROM_EMAIL=noreply@localhost
FROM_NAME=Boilerplate App
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# -----------------------------------------------------------------------------
# Scaling
# -----------------------------------------------------------------------------
UVICORN_WORKERS=2
NEXTJS_WORKERS=1

# -----------------------------------------------------------------------------
# SEO
# -----------------------------------------------------------------------------
SITE_NAME=Boilerplate App
DEFAULT_OG_IMAGE=/images/og-default.png
SOCIAL_HANDLES=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
